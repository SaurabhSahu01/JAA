# ===========================================
# JAA — Environment Variables Template
# ===========================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# --- Firebase Client Config (safe for client-side, prefixed with NEXT_PUBLIC_) ---
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your_measurement_id

# --- Firebase Admin SDK (SERVER ONLY — generate from Firebase Console → Service Accounts) ---
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----\n"

# --- Firebase Storage ---
FIREBASE_STORAGE_BUCKET=gs://your_project.appspot.com

# --- Security ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here

# --- Admin Panel Credentials ---
ADMIN_USERNAME=your_admin_username
ADMIN_PASSWORD=your_admin_password
